# dsproxy configuration
# Copy to .env and adjust. API keys come from the client Authorization header.

HOST_PORT=9999
BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-pro # or deepseek-v4-flash
THINKING=enabled
REASONING_EFFORT=max
DISPLAY_REASONING=true
COLLAPSIBLE_REASONING=true
VERBOSE=false
REQUEST_TIMEOUT=300
MAX_REQUEST_BODY_BYTES=20971520
CORS=false

# HOST and PORT are set explicitly in docker-compose.yml (0.0.0.0:9999).
# Uncomment below only when running directly (without Docker Compose).
# HOST=127.0.0.1
# PORT=9999

# Docker Compose: use the default /home/nonroot/.dsproxy path.
# Host / direct run: comment out the line below to use ~/.dsproxy/reasoning_content.sqlite3.
REASONING_CONTENT_PATH=/home/nonroot/.dsproxy/reasoning_content.sqlite3
MISSING_REASONING_STRATEGY=recover
REASONING_CACHE_MAX_AGE_SECONDS=2592000
REASONING_CACHE_MAX_ROWS=100000

CLEAR_REASONING_CACHE=false

# Set to a directory path to write JSON trace files for debugging.
# Each POST /v1/chat/completions request produces one file with redacted auth headers.
# TRACE_DIR=./traces
TRACE_DIR=
